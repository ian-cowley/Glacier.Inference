#version 450
// Gated DeltaNet depthwise causal conv (kernel 4) + SiLU, with rolling history state.
// state layout per channel: [h0,h1,h2] (3 previous inputs, oldest first). Matches CPU SsmStateCache conv state.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer QKV { float qkv[]; };
layout(std430, binding = 1) readonly buffer CW { float cw[]; };      // [channels][4]
layout(std430, binding = 2) buffer CS { float cs[]; };              // [channels][3]
layout(std430, binding = 3) writeonly buffer OUT { float o[]; };
layout(push_constant) uniform PC { uint channels; } pc;
void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.channels) return;
    float h0 = cs[c * 3u], h1 = cs[c * 3u + 1u], h2 = cs[c * 3u + 2u];
    float x = qkv[c];
    float acc = h0 * cw[c * 4u] + h1 * cw[c * 4u + 1u] + h2 * cw[c * 4u + 2u] + x * cw[c * 4u + 3u];
    cs[c * 3u] = h1; cs[c * 3u + 1u] = h2; cs[c * 3u + 2u] = x;
    o[c] = acc / (1.0 + exp(-acc));
}
