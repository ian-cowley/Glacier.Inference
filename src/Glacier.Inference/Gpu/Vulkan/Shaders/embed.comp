#version 450
#extension GL_GOOGLE_include_directive : enable
// Embedding gather: x[i] = dequant(table[token][i]) for i in [0, dim). One workgroup of 256 threads.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) writeonly buffer X { float x[]; };
layout(push_constant) uniform PC { uint dim; uint token; } pc;

#include "qdq.glsl"

void main() {
    uint nb = pc.dim / BLK;
    for (uint i = gl_LocalInvocationID.x; i < pc.dim; i += 256u) {
        uint blk = i / BLK, e = i % BLK;
        x[i] = dq((pc.token * nb + blk) * BYTES, e);
    }
}
