#version 450
// DeepSeek Sparse Attention (DSA) Lightning Indexer:
// Computes ReLU(qIdx · kIdxCache[t]) * wIdx, selects top-K indices into topIdx[0..topK-1].
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer QI { float qIdx[]; };       // [nIdxHeads][idxDim]
layout(std430, binding = 1) buffer KI { float kIdxCache[]; };           // [maxSeq][idxDim]
layout(std430, binding = 2) readonly buffer WI { float wIdx[]; };       // [nIdxHeads]
layout(std430, binding = 3) writeonly buffer TO { uint topIdx[]; };     // [topK]
layout(std430, binding = 4) readonly buffer KC { float kIdxCur[]; };    // [idxDim]
layout(push_constant) uniform PC { uint seqLen; uint nIdxHeads; uint idxDim; uint topK; } pc;
shared float scores[4096];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint curPos = pc.seqLen - 1u;
    for (uint d = t; d < pc.idxDim; d += 256u) {
        kIdxCache[curPos * pc.idxDim + d] = kIdxCur[d];
    }
    barrier();
    for (uint pos = t; pos < pc.seqLen; pos += 256u) {
        float s = 0.0;
        for (uint h = 0u; h < pc.nIdxHeads; h++) {
            float dotv = 0.0;
            for (uint d = 0u; d < pc.idxDim; d++) {
                dotv += qIdx[h * pc.idxDim + d] * kIdxCache[pos * pc.idxDim + d];
            }
            s += max(dotv, 0.0) * wIdx[h];
        }
        scores[pos] = s;
    }
    barrier();

    if (t == 0u) {
        uint k = min(pc.topK, pc.seqLen);
        for (uint i = 0u; i < k; i++) {
            float best = -1e30;
            uint bestIdx = 0u;
            for (uint pos = 0u; pos < pc.seqLen; pos++) {
                if (scores[pos] > best) { best = scores[pos]; bestIdx = pos; }
            }
            topIdx[i] = bestIdx;
            scores[bestIdx] = -1e30;
        }
    }
}
