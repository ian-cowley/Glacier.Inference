#version 450
// Elementwise ops. -DOP=0: out[i] = silu(a[i]) * b[i]  (SwiGLU)   -DOP=1: a[i] += b[i]  (residual add; out unused)
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) buffer B { float b[]; };
layout(std430, binding = 2) buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
#if OP == 0
    float g = a[i];
    o[i] = (g / (1.0 + exp(-g))) * b[i];
#else
    a[i] += b[i];
#endif
}
