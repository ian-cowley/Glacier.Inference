<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Inference</PackageId>
    <Version>1.5.0</Version>
    <PackageReleaseNotes>v1.5.0: Introduces HOPE (Hierarchical Optimizing Processing Ensemble) Continuum Memory System and Titans neural long-term memory architecture (arXiv:2512.24695, arXiv:2412.21137). Implements unmanaged 64-byte aligned AssociativeMemoryBlockHeader, multi-frequency clock recurrence (Token w0, FastChunk w1, SlowChunk w2, LongTerm w3), AVX-512 and AVX2 vectorized associative forward/adjoint-backward passes, spectral radius stability gating, surprise-driven gated memory consolidation, and zero-allocation speculative save/restore checkpoints.</PackageReleaseNotes>

    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Universal pure C# .NET 10 Multimodal LLM, Generative Image &amp; Video, Vision &amp; Voice inference engine supporting Meta Llama 3, DeepSeek V2/V3/R1 (MLA + MoE), Microsoft Phi-3/Phi-4, Google Gemma 2/4, Mistral, Alibaba Qwen 2/2.5/3.5, FLUX.1 &amp; Wan 2.1 Diffusion Transformers, VAE Decoders, ViT/SigLIP Vision Preprocessing, 2D Spatial Multimodal Projectors, Video Frame Samplers, 3D-RoPE Spatio-Temporal Embeddings, KittenTTS Neural Speech Synthesis, and Formant TTS. Features Tiered Virtual Memory Management (Hot VRAM / Warm Pinned Host RAM / Cold NVMe mmap), Bandwidth-Adaptive Co-Scheduling (q* policy), Tiered MoE Runner, and IQ1/IQ2/IQ3/IQ4/Q2_K/Q4_K quantization kernels. Native AOT compatible, zero-copy GGUF memory-mapped files, AVX-512/AVX2 quantized SIMD kernels, bare-metal GPU acceleration, and pure C# Log-Mel audio DSP. Zero Python, zero C++ runtime dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Inference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Inference.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;inference;diffusion;dit;flowmatching;vae;imagegeneration;video;3drope;vision;vlm;vit;siglip;multimodal;audio;tts;stt;whisper;kokoro;voice;llama;deepseek;phi4;mistral;qwen;gemma2;gguf;simd;avx512;quantization;net10;aot;nativeaot;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Gpu\Kernels\kernels.cubin" />
    <!-- Pre-compiled Vulkan compute shaders (rebuild with Gpu/Vulkan/Shaders/build_shaders.sh) -->
    <EmbeddedResource Include="Gpu\Vulkan\Shaders\*.spv" LogicalName="vkshader.%(Filename)%(Extension)" />
    <None Include="Gpu\Vulkan\Shaders\*.comp;Gpu\Vulkan\Shaders\*.glsl;Gpu\Vulkan\Shaders\*.sh" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Inference.Tests" />
    <InternalsVisibleTo Include="Glacier.Inference.Distributed" />
    <InternalsVisibleTo Include="Glacier.Cluster" />
    <InternalsVisibleTo Include="Glacier.Cluster.Tests" />
  </ItemGroup>
</Project>

