<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Inference</PackageId>
    <Version>1.2.8</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Universal pure C# .NET 10 Multimodal LLM, Generative Image &amp; Video, Vision &amp; Voice inference engine supporting Meta Llama 3, DeepSeek V2/V3/R1 (MLA + MoE), Microsoft Phi-3/Phi-4, Google Gemma 2/4, Mistral, Alibaba Qwen 2/2.5/Qwen2-VL, Flow-Matching DiT (Text-to-Image), Latent VAE Decoders, ViT/SigLIP Vision Preprocessing, 2D Spatial Multimodal Projectors, Video Frame Samplers, 3D-RoPE Spatio-Temporal Embeddings, Whisper STT, and Kokoro-82M TTS. Native AOT compatible, zero-copy GGUF memory-mapped files, AVX-512/AVX2 quantized SIMD kernels, bare-metal GPU acceleration, pure C# Log-Mel audio DSP, and full-duplex conversational voice. Zero Python, zero C++ runtime dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Inference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Inference.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;inference;diffusion;dit;flowmatching;vae;imagegeneration;video;3drope;vision;vlm;vit;siglip;multimodal;audio;tts;stt;whisper;kokoro;voice;llama;deepseek;phi4;mistral;qwen;gemma2;gguf;simd;avx512;quantization;net10;aot;nativeaot;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Gpu\Kernels\kernels.cubin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
  </ItemGroup>
</Project>
